{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "picnic": {
        "description": "Picnic logs",
        "regex": {
            "std": {
                "pattern": "^(?P<timestamp>[-+T.:\\d\\s]+)\\s+(?P<level>\\w+)\\s+\\[sim-time=(?P<sim_time>[\\d.]+)\\s+trace-id=(?P<trace_id>[^\\s]+)\\s+module=(?P<module>[^\\]]+)\\]\\s+(?P<body>.*)$"
            }
        },
        "level-field": "level",
        "opid-field": "trace_id",
        "timestamp-format": [
            "%Y-%m-%d %H:%M:%S",
            "%Y-%m-%dT%H:%M:%S.%N%z"
        ],
        "level": {
            "error": "ERROR",
            "warning": "WARNING",
            "info": "INFO",
            "debug": "DEBUG"
        },
        "value": {
            "sim_time": {
                "kind": "float"
            },
            "trace_id": {
                "kind": "string",
                "identifier": true
            },
            "module": {
                "kind": "string",
                "identifier": true
            },
            "level": {
                "kind": "string"
            },
            "timestamp": {
                "kind": "string"
            }
        },
        "sample": [
            {
                "line": "2026-02-26 13:36:55 ERROR [sim-time=30.58 trace-id=EuXPQfH7 module=async_environment] Timed out waiting for ack/nak for message 678639c7-a7a0-4781-9aa1-fc770f9196f4",
                "level": "error"
            },
            {
                "line": "2026-03-12T16:24:25.582870327+0100 INFO  [sim-time=25727.00 trace-id=(none) module=async_consumer] Received message on exchange picnic.ws with routing key TS7.StartTransportRequest",
                "level": "info"
            }
        ]
    }
}
