{{ if eq .osid "linux-debian" "linux-raspbian" "linux-ubuntu" -}}
{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{ $sudo = "" -}}
{{ end -}}
#!{{ lookPath "bash" }}

if ! command -v npm >/dev/null; then
    {{ $sudo }}apt-get update
    {{ $sudo }}apt-get install -y nodejs npm
fi

{{ $sudo }}npm install -g @bitwarden/cli bitwarden-cli-bio

status="$(bwbio status)"
current_server="$(echo "$status" | jq -r '.serverUrl // empty')"
current_email="$(echo "$status" | jq -r '.userEmail // empty')"

if [ "$current_server" != "{{ .bitwarden.server }}" ]; then
    if [ -n "$current_email" ]; then
        bwbio logout
    fi
    bwbio config server {{ .bitwarden.server }}
fi

if [ "$current_email" != "{{ .bitwarden.email }}" ]; then
    bwbio login {{ .bitwarden.email }}
fi
{{ end -}}
