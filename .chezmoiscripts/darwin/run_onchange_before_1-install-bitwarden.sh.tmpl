{{ if eq .osid "darwin" -}}
#!{{ lookPath "bash" }}

brew install bitwarden-cli jeanregisser/tap/bitwarden-cli-bio

status="$(bwbio status)"
current_server="$(echo "$status" | jq -r '.serverUrl // empty')"
current_email="$(echo "$status" | jq -r '.userEmail // empty')"

if [ "$current_server" != "{{ .bitwarden.server }}" ]; then
    if [ -n "$current_email" ]; then
        bwbio logout
    fi
    bwbio config server {{ .bitwarden.server }}
fi

if [ "$current_email" != "{{ .bitwarden.email }}" ]; then
    bwbio login {{ .bitwarden.email }}
fi
{{ end -}}
